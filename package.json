{
  "name": "mathe-turm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mathe-Turm - Rechen-Spiel fuer Kinder (Klasse 1-5)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-tasks.mjs",
    "icons": "node scripts/make-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "assets": "node scripts/make-icons.mjs && node scripts/fetch-fonts.mjs",
    "smoke": "esbuild scripts/smoke-entry.jsx --bundle --platform=node --format=esm --jsx=automatic --external:react* --outfile=scripts/.smoke.mjs --log-level=warning && node scripts/.smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}
